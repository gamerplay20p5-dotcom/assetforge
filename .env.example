# ---------------------------------------------------------------------------------------------
# AssetForge - environment template. Copy to .env (central server) and .env.worker (workers).
# NEVER commit real values. Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------------------------

# ===== Central server (deployment/docker-compose.central.yml) =====
POSTGRES_PASSWORD=change-me
ASSETFORGE_SECRET_KEY=change-me-long-random-string
ASSETFORGE_ADMIN_USERNAME=admin
ASSETFORGE_ADMIN_PASSWORD=change-me-too
# Interface/port published by the API. Use 127.0.0.1 if a reverse proxy runs on the same host.
ASSETFORGE_BIND=0.0.0.0
ASSETFORGE_PORT=8000
ASSETFORGE_MAX_UPLOAD_MB=256
# Optional LOCAL language model for text -> generator parameters (Ollama-compatible). Empty = deterministic rules.
ASSETFORGE_LLM_URL=
ASSETFORGE_LLM_MODEL=

# ===== Workers (deployment/docker-compose.worker-*.yml) =====
# Address of the central API as seen from the worker (no IP is hardcoded anywhere in the code).
ASSETFORGE_SERVER_URL=http://central-host:8000
# One-time token created in the dashboard (Workers -> Novo token de registro). Only needed on first start.
ASSETFORGE_ENROLLMENT_TOKEN=
ASSETFORGE_WORKER_NAME=worker-01
ASSETFORGE_WORKER_MAX_JOBS=1
# Logical reservation enforced by the scheduler (defaults claim only half of the machine).
ASSETFORGE_WORKER_CPU_CORES=4
ASSETFORGE_WORKER_RAM_MB=6144
# Hard limits enforced by Docker
ASSETFORGE_WORKER_DOCKER_CPUS=4
ASSETFORGE_WORKER_DOCKER_MEM=6g
ASSETFORGE_WORKER_SCRATCH=4g
# Idle-time processing so other services (e.g. AI Stream Clipper) are not disturbed:
#   active hours (24h, may cross midnight), e.g. "22:00-07:00" ; empty = always
ASSETFORGE_WORKER_ACTIVE_HOURS=
#   do not START jobs while the host CPU average is above this percentage (0 = disabled)
ASSETFORGE_WORKER_MAX_HOST_CPU_PERCENT=0
#   do not START jobs while a process whose name/cmdline contains any of these is running (comma separated)
ASSETFORGE_WORKER_YIELD_TO=ai-stream-clipper
# Intel GPU nodes only: numeric gid of the host 'render' group (getent group render)
RENDER_GID=109
