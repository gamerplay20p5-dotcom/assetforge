# The host's tested CUDA build is supplied as ENGINE_IMAGE.
ARG ENGINE_IMAGE=assetforge-pixal3d:cuda89
FROM ${ENGINE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv ca-certificates procps \
    && python3 -m venv /opt/assetforge-env && rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/assetforge-env/bin:$PATH \
    PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 ASSETFORGE_WORKER_KIND=nvidia ASSETFORGE_WORKER_STATE_DIR=/state \
    PYTHONPATH=/app/workers/cpu:/app/generators/procedural:/app/generators/vision:/app/generators/intel_ai:/app/generators/mesh:/app/pipeline/validation:/app/pipeline/optimization:/app/pipeline/export:/app/packages/asset-contract
WORKDIR /app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY workers/cpu workers/cpu
COPY generators/procedural generators/procedural
COPY generators/vision generators/vision
COPY generators/intel_ai generators/intel_ai
COPY generators/mesh generators/mesh
COPY pipeline pipeline
COPY packages packages
RUN useradd --system --uid 10002 --create-home assetforge \
    && install -d -o assetforge -g assetforge /state /state/jobs
USER assetforge
CMD ["python", "-m", "assetforge_worker"]
