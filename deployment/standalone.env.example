# ---------------------------------------------------------------------------------------------
# PERFIL STANDALONE: tudo na mesma máquina, PostgreSQL local em Docker.
# Copie para .env (chmod 600) — ou rode scripts/install_single_node.sh standalone, que gera os segredos.
# ---------------------------------------------------------------------------------------------
COMPOSE_PROFILES=standalone,cpu3d     # cpu3d = providers CPU de image-to-3D; "ai" = Intel/ComfyUI (DESABILITADO)

POSTGRES_PASSWORD=change-me
ASSETFORGE_SECRET_KEY=change-me-long-random-string
ASSETFORGE_ADMIN_USERNAME=admin
ASSETFORGE_ADMIN_PASSWORD=change-me-too
# Tokens de registro (uso único) criados na subida da API; o install script gera. Um por worker.
ASSETFORGE_BOOTSTRAP_ENROLLMENT_TOKENS=
ASSETFORGE_ENROLLMENT_TOKEN_CPU=
ASSETFORGE_ENROLLMENT_TOKEN_GPU=
ASSETFORGE_ENROLLMENT_TOKEN_AI=
HOSTNAME_TAG=node206

# Rede: porta do painel/API. Use 127.0.0.1 se houver proxy TLS na mesma máquina.
ASSETFORGE_BIND=0.0.0.0
ASSETFORGE_PORT=8000

# GPU Intel (acesso via /dev/dri, sem privileged): gids dos grupos do HOST — o install script detecta.
RENDER_GID=
VIDEO_GID=44

# ---------------- Limites (a 206 tem ~32 núcleos / 200 GB RAM; ajuste ao que outros serviços precisam) ----------------
CPU_WORKER_MAX_JOBS=2
CPU_WORKER_CORES=8
CPU_WORKER_RAM_MB=16384
CPU_WORKER_DOCKER_CPUS=8
CPU_WORKER_DOCKER_MEM=16g
GPU_WORKER_CORES=4
GPU_WORKER_RAM_MB=16384
GPU_WORKER_DOCKER_CPUS=4
GPU_WORKER_DOCKER_MEM=16g
COMFY_DOCKER_CPUS=8
COMFY_DOCKER_MEM=64g
ASSETFORGE_API_CPUS=2
ASSETFORGE_API_MEM=2g
ASSETFORGE_WORKER_SCRATCH=4g

# ---------------- IA (ComfyUI / PyTorch XPU) ----------------
# Offload para RAM: --lowvram (padrão) ou --novram (mais lento, usa menos VRAM). Valores NÃO validados na A750: calibrar.
COMFY_MEMORY_ARGS=--lowvram
COMFY_RESERVE_VRAM=1.0
COMFY_EXTRA_ARGS=
ASSETFORGE_AI_VRAM_MB=7000
# 0 = a IA só é oferecida após scripts/intel_ai/docker_tasks.sh validate (execução real). 1 = por sua conta e risco.
ASSETFORGE_AI_ALLOW_UNVALIDATED=0

# ---------------- Coexistência com outros serviços ----------------
ASSETFORGE_WORKER_ACTIVE_HOURS=
ASSETFORGE_WORKER_MAX_HOST_CPU_PERCENT=0
ASSETFORGE_WORKER_YIELD_TO=

# ---------------- Providers CPU de image-to-3D (Stable Fast 3D, TripoSR) ----------------
CPU3D_THREADS=12             # threads de PyTorch por geração
CPU3D_CONCURRENCY=1          # gerações simultâneas por provider
CPU3D_DOCKER_CPUS=12         # teto de CPU de cada container de provider
CPU3D_DOCKER_MEM=24g         # teto de RAM de cada container de provider
CPU3D_JOB_TIMEOUT=3600       # segundos
CPU3D_SCRATCH=6g
CPU3D_JOB_RAM_MB=16384       # RAM que o scheduler reserva por job (calibrar com o benchmark)
CPU3D_OFFLINE=0              # 1 depois de baixar os pesos: sem acesso à internet
AI_WORKER_MAX_JOBS=1
AI_WORKER_CORES=12
AI_WORKER_RAM_MB=24576
AI_WORKER_DOCKER_CPUS=4
AI_WORKER_DOCKER_MEM=8g
# Token do Hugging Face SOMENTE para baixar os pesos 'gated' do Stable Fast 3D (aceite a licença com a sua conta). Não é usado em runtime.
HF_TOKEN=
# Intel/ComfyUI (opção futura, desabilitada):
ASSETFORGE_ENABLE_INTEL_AI=0

# ---------------- Visão local (perfil vision): Qwen2.5-VL 7B em CPU, lê a imagem de referência e descreve a casa ----------------
# Passos: ./scripts/vlm/tasks.sh download && ./scripts/vlm/tasks.sh up   (o 'up' acrescenta o perfil vision e ASSETFORGE_VLM_URL ao .env)
# ASSETFORGE_VLM_URL=http://vlm:8080
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct      # 7B = Apache-2.0 (uso comercial livre). O 3B é "Qwen Research": NÃO use em produção comercial.
VLM_THREADS=20
VLM_DOCKER_CPUS=22                          # ~70% de 32 threads
VLM_DOCKER_MEM=64g                          # o 7B em float32 usa ~32 GB medidos
VLM_IDLE_UNLOAD_SECONDS=900                 # descarrega o modelo da RAM após 15 min parado

# ---------------- Caixa de GPU (ex.: 203, RTX 4090): só inferência; o resto (API, Blender, CPU, RAM) fica neste nó ----------------
# Na caixa de GPU: ./scripts/vlm/gpu_box.sh build && ./scripts/vlm/gpu_box.sh download && ./scripts/vlm/gpu_box.sh up   (token em .env.gpu)
# Aqui: GPU primeiro, o container de CPU (perfil vision) como reserva, e o mesmo token:
# ASSETFORGE_VLM_URL=http://192.168.1.203:8081,http://vlm:8080
# ASSETFORGE_VLM_TOKEN=<VLM_TOKEN de .env.gpu>
